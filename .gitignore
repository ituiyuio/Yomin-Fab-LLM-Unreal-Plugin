# Local LRH tool state — generated during sessions, not part of the project
/.lrh/

# Brainstorm session artifacts (visual companion mockups) — local to a session
/.superpowers/

# Subagent worktrees — generated by parallel agent invocations
/.claude/worktrees/

# LLMEasyShell runtime state (port assignments, ready events, crash dumps, log)
/skills/llm-easy-shell/llm-shell/.current_port
/skills/llm-easy-shell/llm-shell/.ready_event
/skills/llm-easy-shell/llm-shell/.llmshell_crash_state
/skills/llm-easy-shell/llm-shell/llm-shell-quiet.log
/skills/llm-easy-shell-lite/llmshelllite/.current_port
/skills/llm-easy-shell-lite/llmshelllite/.ready_event
/skills/llm-easy-shell-lite/llmshelllite/.llmshell_crash_state
/skills/llm-easy-shell-lite/llmshelllite/llmshelllite-quiet.log

# Build artifacts (CMake / MSVC)
/*.obj
/**/*.obj
/build/
**/build/

# Playwright CLI session artifacts
/.playwright-cli/
**/.playwright-cli/

# Python cache
/__pycache__/
**/__pycache__/
